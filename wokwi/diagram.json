    { "type": "wokwi-hc-sr04", "id": "ultrasonic", "top": -120, "left": 150, "attrs": {} },
    { "type": "wokwi-pushbutton", "id": "rain_button", "top": 120, "left": 150, "attrs": { "color": "blue" } },
    { "type": "wokwi-potentiometer", "id": "battery_pot", "top": 200, "left": 150, "attrs": {} }
